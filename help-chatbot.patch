diff --git a/supabase/migrations/0008_help_chatbot.sql b/supabase/migrations/0008_help_chatbot.sql
new file mode 100644
index 0000000..7a399ba
--- /dev/null
+++ b/supabase/migrations/0008_help_chatbot.sql
@@ -0,0 +1,367 @@
+-- ============================================================
+-- 0008 — In-app help chatbot (FAQ knowledge base + search)
+--   1. pg_trgm for typo-tolerant matching
+--   2. help_faqs          : the chatbot's knowledge base (public read, admin write)
+--   3. help_unanswered    : questions the bot could not answer (insert-only for users, admin read)
+--   4. search_help_faqs() : ranks FAQs for a free-text question
+--   5. log_unanswered_question()
+--   6. Seed answers about Second Serving (idempotent)
+-- Safe to re-run.
+-- ============================================================
+
+-- ------------------------------------------------------------
+-- 1. Extension
+-- ------------------------------------------------------------
+create schema if not exists extensions;
+create extension if not exists pg_trgm with schema extensions;
+
+-- ------------------------------------------------------------
+-- 2. Knowledge base
+-- ------------------------------------------------------------
+create table if not exists help_faqs (
+  id          uuid primary key default gen_random_uuid(),
+  slug        text not null unique,
+  category    text not null,
+  question    text not null,
+  answer      text not null,
+  keywords    text[] not null default '{}',   -- lower-case words / phrases people may type
+  link_path   text,                           -- in-app route, e.g. /donations/new
+  link_label  text,
+  sort_order  int  not null default 100,
+  is_active   boolean not null default true,
+  created_at  timestamptz not null default now(),
+  updated_at  timestamptz not null default now(),
+  constraint help_faqs_link_path_internal check (link_path is null or link_path like '/%')
+);
+
+alter table help_faqs enable row level security;
+
+drop policy if exists "help_faqs public read" on help_faqs;
+create policy "help_faqs public read" on help_faqs
+  for select to anon, authenticated
+  using (is_active or is_admin(auth.uid()));
+
+drop policy if exists "help_faqs admin write" on help_faqs;
+create policy "help_faqs admin write" on help_faqs
+  for all to authenticated
+  using (is_admin(auth.uid()))
+  with check (is_admin(auth.uid()));
+
+-- ------------------------------------------------------------
+-- 3. Unanswered questions (lets admins see what to add next)
+-- ------------------------------------------------------------
+create table if not exists help_unanswered (
+  id          uuid primary key default gen_random_uuid(),
+  query       text not null check (char_length(query) between 1 and 300),
+  user_id     uuid references profiles(id) on delete set null,
+  created_at  timestamptz not null default now()
+);
+
+alter table help_unanswered enable row level security;
+
+drop policy if exists "help_unanswered admin read" on help_unanswered;
+create policy "help_unanswered admin read" on help_unanswered
+  for select to authenticated
+  using (is_admin(auth.uid()));
+
+drop policy if exists "help_unanswered admin delete" on help_unanswered;
+create policy "help_unanswered admin delete" on help_unanswered
+  for delete to authenticated
+  using (is_admin(auth.uid()));
+-- No insert policy on purpose: inserts only go through log_unanswered_question().
+
+-- Explicit table grants (RLS above is what actually restricts access)
+grant select on help_faqs to anon, authenticated;
+grant insert, update, delete on help_faqs to authenticated;
+grant select, delete on help_unanswered to authenticated;
+
+-- ------------------------------------------------------------
+-- 4. Search
+--    score = keyword phrase hits (1.5) + fuzzy single-word keyword hits (0.8)
+--          + 2 * trigram similarity to the question + 3 * full-text rank
+--    The client treats score >= 1.0 as "confident enough to answer".
+-- ------------------------------------------------------------
+create or replace function search_help_faqs(p_query text, p_limit int default 3)
+returns table (
+  id uuid,
+  category text,
+  question text,
+  answer text,
+  link_path text,
+  link_label text,
+  score real
+)
+language sql
+stable
+security invoker
+set search_path = public, extensions, pg_temp
+as $$
+  with q as (
+    select
+      nullif(trim(regexp_replace(lower(left(coalesce(p_query, ''), 300)), '[^a-z0-9 ]', ' ', 'g')), '') as text,
+      array(
+        select t
+        from unnest(regexp_split_to_array(
+          trim(regexp_replace(lower(left(coalesce(p_query, ''), 300)), '[^a-z0-9 ]', ' ', 'g')), '\s+'
+        )) as t
+        where char_length(t) >= 3
+      ) as tokens
+  )
+  select
+    f.id, f.category, f.question, f.answer, f.link_path, f.link_label,
+    (
+      coalesce((
+        select sum(
+          case
+            when position(' ' || k || ' ' in ' ' || q.text || ' ') > 0 then 1.5
+            when k !~ '\s' and exists (
+              select 1 from unnest(q.tokens) t where similarity(t, k) >= 0.55
+            ) then 0.8
+            else 0
+          end)
+        from unnest(f.keywords) as k
+      ), 0)
+      + 2 * similarity(f.question, q.text)
+      + 3 * ts_rank(
+          to_tsvector('english', f.question || ' ' || f.answer),
+          plainto_tsquery('english', q.text)
+        )
+    )::real as score
+  from help_faqs f, q
+  where q.text is not null
+    and f.is_active
+  order by score desc, f.sort_order, f.question
+  limit greatest(1, least(coalesce(p_limit, 3), 10));
+$$;
+
+revoke all on function search_help_faqs(text, int) from public;
+grant execute on function search_help_faqs(text, int) to anon, authenticated;
+
+-- ------------------------------------------------------------
+-- 5. Log a question the bot could not answer
+-- ------------------------------------------------------------
+create or replace function log_unanswered_question(p_query text)
+returns void
+language plpgsql
+security definer
+set search_path = public, pg_temp
+as $$
+declare
+  v_q text := left(trim(coalesce(p_query, '')), 300);
+begin
+  if char_length(v_q) = 0 then
+    return;
+  end if;
+  insert into help_unanswered (query, user_id) values (v_q, auth.uid());
+end;
+$$;
+
+revoke all on function log_unanswered_question(text) from public;
+grant execute on function log_unanswered_question(text) to anon, authenticated;
+
+-- ------------------------------------------------------------
+-- 6. Seed content (upsert by slug, so re-running refreshes the text)
+-- ------------------------------------------------------------
+insert into help_faqs (slug, category, question, answer, keywords, link_path, link_label, sort_order) values
+
+('what-is-app', 'About',
+ 'What is Second Serving?',
