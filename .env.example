# Copy this file to .env and fill in values from your Supabase project
# (Project Settings → API). Never commit the real .env file.

# Safe to expose to the browser — this is the public anon key, gated by
# Row Level Security, not a secret.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------
# The following belong ONLY in Supabase project secrets / server-side
# environments (Edge Functions), never in this file or anywhere under
# src/. Listed here for reference only — do not set VITE_-prefixed
# versions of these, ever.
#   SUPABASE_SERVICE_ROLE_KEY
#   SUPABASE_URL (server context)
# ---------------------------------------------------------------------
